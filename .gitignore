# Raw and processed data are not versioned, but the folder structure is kept.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Trained models are not versioned, but the folder structure and README are kept.
models/*
!models/README.md
!models/custom_cnn/
models/custom_cnn/*
!models/custom_cnn/.gitkeep

# Model weights anywhere in the repository.
*.h5
*.keras

# Python cache files.
__pycache__/
*.pyc

# Jupyter checkpoints.
.ipynb_checkpoints/